@model string
@{
    var textContent = ViewBag.TextContent as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shared text · Share Anywhere</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/ShareAnywhere_Logo.png")" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body>
    <header class="topbar">
        <div class="shell topbar-inner">
            <a class="brand" href="@Url.Action("Upload", "File")">
                <img src="@Url.Content("~/ShareAnywhere_Logo.png")" width="36" height="36" alt="" />
                Share Anywhere
            </a>
        </div>
    </header>

    <main class="detail-shell">
        <section class="panel detail-panel" aria-labelledby="text-title">
            <h1 id="text-title">Shared text</h1>
            @if (textContent != null)
            {
                <pre id="sharedText" class="shared-text">@textContent</pre>
                <div class="inline-actions">
                    <button class="button primary" type="button" data-copy-target="sharedText">Copy text</button>
                </div>
            }
            else if (Model != null)
            {
                <form method="post" action="@Url.Action("RevealText", "File")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="code" value="@Model" />
                    <p class="detail-intro">This snippet has a limited number of views.</p>
                    <button class="button primary" type="submit">Reveal text</button>
                </form>
            }
            else
            {
                <p class="message error">This text is unavailable.</p>
            }
        </section>
    </main>

    <script src="@Url.Content("~/js/share-actions.js")"></script>
</body>
</html>
