@{
    var isText = ViewBag.IsText is true;
    var remaining = ViewBag.RemainingUses as int?;
    var usageLabel = isText ? "view" : "download";
    var downloadLink = ViewBag.DownloadLink as string;
    var code = ViewBag.Code as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Link ready · Share Anywhere</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/ShareAnywhere_Logo.png")" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body>
    <header class="topbar">
        <div class="shell topbar-inner">
            <a class="brand" href="@Url.Action("Upload", "File")">
                <img src="@Url.Content("~/ShareAnywhere_Logo.png")" width="36" height="36" alt="" />
                Share Anywhere
            </a>
        </div>
    </header>

    <main class="detail-shell">
        <section class="panel detail-panel" aria-labelledby="result-title">
            <h1 id="result-title">@(isText ? "Text link ready" : "Link ready")</h1>
            @if (!isText && ViewBag.FileName is string fileName)
            {
                <p class="detail-intro">@fileName</p>
            }
            @if (downloadLink != null)
            {
                <div class="link-card">
                    @if (remaining.HasValue)
                    {
                        <span class="chip">@remaining @usageLabel@(remaining.Value == 1 ? "" : "s") left</span>
                    }
                    <div class="link-controls">
                        <a id="resultUrl" class="share-url" href="@downloadLink" target="_blank" rel="noopener">@downloadLink</a>
                        <button class="button primary" type="button" data-copy-target="resultUrl">Copy link</button>
                    </div>
                    <div class="link-tools">
                        @if (code != null)
                        {
                            <p class="hint">Share code <strong class="share-code">@code</strong></p>
                        }
                        @if (ViewBag.ExpiresAt is DateTimeOffset expiresAt)
                        {
                            <p class="hint" id="resultExpiry" data-expires="@expiresAt.ToString("O")"></p>
                        }
                        <details id="resultQrDetails" class="qr-details" hidden>
                            <summary><span class="qr-show">Show QR</span><span class="qr-hide">Hide QR</span></summary>
                            <div id="resultQr" class="qr-code"></div>
                        </details>
                    </div>
                </div>
            }
            else
            {
                <p class="message error">This link is unavailable.</p>
            }

            <div class="inline-actions">
                <a class="button secondary" href="@Url.Action("Upload", "File")">Create another share</a>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/lib/qrcodejs/qrcode.min.js")"></script>
    <script src="@Url.Content("~/js/share-actions.js")"></script>
    <script>
        const resultUrl = document.getElementById("resultUrl");
        if (resultUrl) {
            resultUrl.textContent = resultUrl.href;
            updateShareQr(document.getElementById("resultQrDetails"), document.getElementById("resultQr"), resultUrl.href);
        }

        const resultExpiry = document.getElementById("resultExpiry");
        if (resultExpiry) {
            resultExpiry.textContent = "Expires at " + formatShareExpiry(resultExpiry.dataset.expires);
        }
    </script>
</body>
</html>
