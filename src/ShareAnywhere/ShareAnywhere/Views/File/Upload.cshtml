<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Share Anywhere</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/ShareAnywhere_Logo.png")" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body>
    <header class="topbar">
        <div class="shell topbar-inner">
            <a class="brand" href="@Url.Action("Upload", "File")">
                <img src="@Url.Content("~/ShareAnywhere_Logo.png")" width="36" height="36" alt="" />
                Share Anywhere
            </a>
            <details class="device-settings" id="deviceSettings">
                <summary class="button secondary device-button" aria-label="Edit device name">
                    <span id="deviceNameLabel">This device</span><span aria-hidden="true">✎</span>
                </summary>
                <form class="device-name-form" id="deviceNameForm">
                    <label class="label" for="deviceNameInput">Device name</label>
                    <div class="inline-actions">
                        <input class="input" id="deviceNameInput" maxlength="40" autocomplete="off" required />
                        <button class="button primary" type="submit">Save</button>
                    </div>
                </form>
            </details>
        </div>
    </header>

    <main class="shell workspace">
        <div class="intro">
            <h1>Share a file or text</h1>
            <p>Send to a nearby device or create a share link.</p>
        </div>

        <p id="incomingAnnouncement" class="sr-only" role="status"></p>
        <section class="panel incoming-panel" id="incomingPanel" aria-labelledby="incomingTitle" hidden>
            <h2 id="incomingTitle">Incoming transfers</h2>
            <div id="incomingTransfers" class="incoming-list"></div>
        </section>

        <div class="workspace-grid">
            <section class="panel send-panel" aria-label="Share">
                <div class="mode-switch" role="group" aria-label="What to share">
                    <button id="fileToggle" class="mode-button" type="button" aria-pressed="true">File</button>
                    <button id="textToggle" class="mode-button" type="button" aria-pressed="false">Text</button>
                </div>

                <section id="fileUploadCard">
                    <form id="fileMetadataForm"
                          data-register="@Url.Action("RegisterFile", "File")"
                          data-poll="@Url.Action("PollTransfer", "File")"
                          data-relay="@Url.Action("RelayUploadStream", "File")"
                          data-hub="@Url.Content("~/nearbyHub")"
                          data-max-file-bytes="@ShareAnywhere.Models.ShareLimits.MaxFileBytes"
                          data-max-uses="@ShareAnywhere.Models.ShareLimits.MaxUses">
                        <div id="filePicker">
                            <button class="drop-zone" id="dragDropArea" type="button" aria-describedby="fileLimit">
                                <span class="upload-icon" aria-hidden="true">↑</span>
                                <strong>Choose a file</strong>
                                <span>or drag and drop it here</span>
                            </button>
                            <p id="fileLimit" class="hint">One file up to 1 GiB</p>
                            <div id="fileInfo" class="selected-file" hidden>
                                <div class="file-symbol" aria-hidden="true">↗</div>
                                <div class="file-details" role="status">
                                    <strong id="selectedFileName"></strong>
                                    <span id="selectedFileSize"></span>
                                </div>
                                <button id="changeFile" class="button secondary" type="button">Change file</button>
                            </div>
                            <input type="file" name="uploadedFile" id="uploadedFile" hidden />
                        </div>

                        <div class="share-options" id="fileActions" hidden>
                            <div>
                                <label class="label" for="deleteAfterCount">Download limit</label>
                                <input class="input limit-input" type="number" id="deleteAfterCount" name="deleteAfterCount" value="1" min="1" max="@ShareAnywhere.Models.ShareLimits.MaxUses" required />
                            </div>
                            <button class="button primary" type="submit">Create link <span aria-hidden="true">↗</span></button>
                        </div>
                        <p id="fileMessage" class="message" role="status"></p>
                    </form>

                    <section id="relayInfo" class="link-card" aria-labelledby="linkTitle" hidden>
                        <div class="link-heading">
                            <div>
                                <h2 id="linkTitle">File link</h2>
                                <p id="sharedFileName" class="muted"></p>
                            </div>
                            <span id="linkRemaining" class="chip"></span>
                        </div>
                        <div id="linkControls">
                            <div class="link-controls">
                                <a id="downloadLink" class="share-url" target="_blank" rel="noopener"></a>
                                <button class="button primary" type="button" data-copy-target="downloadLink">Copy link</button>
                            </div>
                            <div class="link-tools">
                                <p class="hint">Share code <strong id="shareCode" class="share-code"></strong></p>
                                <p id="linkExpiry" class="hint"></p>
                                <details id="linkQr" class="qr-details" hidden>
                                    <summary><span class="qr-show">Show QR</span><span class="qr-hide">Hide QR</span></summary>
                                    <div id="relayQrCode" class="qr-code"></div>
                                </details>
                            </div>
                            <p class="hint">Keep this tab open so the recipient can download.</p>
                        </div>
                        <p id="relayStatus" class="message transfer-status" role="status"></p>
                    </section>
                </section>

                <section id="textUploadCard" hidden data-has-error="@(ViewBag.TextError != null ? "true" : "false")">
                    <form method="post" action="@Url.Action("UploadText", "File")">
                        @Html.AntiForgeryToken()
                        @if (ViewBag.TextError != null)
                        {
                            <p class="message error" role="alert">@ViewBag.TextError</p>
                        }
                        <label class="label" for="textContent">Text to share</label>
                        <textarea class="input text-entry" id="textContent" name="textContent" required placeholder="Paste or type your text"></textarea>
                        <div class="share-options">
                            <div>
                                <label class="label" for="textDeleteAfterCount">View limit</label>
                                <input class="input limit-input" type="number" id="textDeleteAfterCount" name="deleteAfterCount" value="1" min="1" max="@ShareAnywhere.Models.ShareLimits.MaxUses" required />
                            </div>
                            <button class="button primary" type="submit">Create text link <span aria-hidden="true">↗</span></button>
                        </div>
                    </form>
                </section>
            </section>

            <aside class="panel nearby-panel" aria-labelledby="nearbyTitle">
                <div class="nearby-heading">
                    <h2 id="nearbyTitle">Nearby Devices</h2>
                    <div id="nearbyStatus" class="status-pill" role="status"><span class="status-dot" aria-hidden="true"></span><span>Connecting</span></div>
                </div>
                <p id="nearbyHint" class="muted">Select a file to send to a nearby device.</p>
                <button id="reconnectNearby" class="button secondary" type="button" hidden>Reconnect</button>
                <div id="peerList" class="peer-list">
                    <p class="empty">No nearby devices yet.</p>
                </div>
                <p id="nearbyMessage" class="message" role="status"></p>
            </aside>
        </div>
        <footer class="page-footer">© 2026 RH-Factory</footer>
    </main>

    <script src="@Url.Content("~/lib/qrcodejs/qrcode.min.js")"></script>
    <script src="@Url.Content("~/lib/signalr/signalr.min.js")"></script>
    <script src="@Url.Content("~/js/share-actions.js")"></script>
    <script src="@Url.Content("~/js/site.js")"></script>
</body>
</html>
