    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj_verify\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot/Uploads/**;App_Data/**" />
    <None Remove="App_Data/**" />
  </ItemGroup>

</Project>
